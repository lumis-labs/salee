# AI
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Use a cheap/free model for repetitive worker replies when available.
OPENROUTER_WORKER_MODEL=
# Use the stronger model for growth planning and final QA.
OPENROUTER_PLANNER_MODEL=
OPENROUTER_QA_MODEL=
GROWTH_QA_ENABLED=true
OPENROUTER_SITE_URL=http://localhost:8080
OPENROUTER_APP_NAME=Revenue Agent
AGENT_NAME=Salee
AGENT_FULL_NAME=Salee Arman
DASHBOARD_PASSWORD=

# AgentMail
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Payments (prefer a Stripe restricted key with only product/price/payment-link permissions)
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# Runtime
DATABASE_PATH=data/revenue_agent.sqlite3
POLL_INTERVAL_SECONDS=60
MAX_EMAILS_PER_DAY=25
MAX_SMS_PER_DAY=10
MAX_LLM_CALLS_PER_CYCLE=8
PUBLIC_BASE_URL=
# VERCEL_URL is accepted as a fallback when PUBLIC_BASE_URL is empty.
WEBHOOK_SECRET=
LOG_LEVEL=INFO

# Business configuration (required before accepting payments or running campaigns)
BUSINESS_NAME=Salee
BUSINESS_DESCRIPTION=Salee helps small businesses find and implement practical AI workflows that increase qualified leads, follow-up, and conversion.
OFFER_NAME=AI Revenue Workflow Sprint
OFFER_PRICE_CENTS=150000
CHECKOUT_URL=
OWNER_EMAIL=
FOLLOW_UP_ENABLED=true
FOLLOW_UP_MESSAGE=Hi {{first_name}}, Salee can map the fastest AI workflow improvements for your business in a focused sprint. Details: {{checkout_url}} Reply STOP to opt out.
FOLLOW_UP_AFTER_HOURS=48
GROWTH_ENABLED=true
GROWTH_INTERVAL_HOURS=6
GROWTH_MAX_CALLS_PER_DAY=4
PROSPECTING_ENABLED=true
PROSPECTING_INTERVAL_MINUTES=30
PROSPECTING_MAX_ITEMS=20
PROSPECTING_QUERIES=AI workflow automation|lead follow up automation|small business AI|sales process automation
# Optional comma-separated public RSS/Atom/JSON source URLs. Do not add private or login-gated URLs.
PROSPECTING_SOURCE_URLS=
FOLLOW_UP_ENABLED=false
FOLLOW_UP_MESSAGE=Hi {{first_name}}, just following up on {{offer_name}}. Details: {{checkout_url}} Reply STOP to opt out.
FOLLOW_UP_AFTER_HOURS=48
